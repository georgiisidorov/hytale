# https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Группа (уже задана по умолчанию в compose)
TELEGRAM_GROUP_ID=-5118253176

# До этой даты/времени в локальном TZ (Termux = пояс телефона)
COUNTDOWN_TARGET=2026-06-05T21:00:00
# TZ=Europe/Moscow

TICK_INTERVAL_SECONDS=300

# SOCKS5 (опционально): host:port:login:password
# TELEGRAM_PROXY=127.0.0.1:1080:user:pass
