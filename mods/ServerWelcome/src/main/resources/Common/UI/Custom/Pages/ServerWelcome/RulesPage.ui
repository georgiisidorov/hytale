$C = "../../Common.ui";

Group #RulesRoot {
  Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
  LayoutMode: Center;

  Group #RulesCard {
    Anchor: (Width: 560, Height: 480);
    Background: (Color: #1a1a2eee);
    LayoutMode: Top;
    OutlineColor: #3a4a6a;
    OutlineSize: 1;

    Group #Header {
      LayoutMode: Left;
      Background: (Color: #0f1525);
      Padding: (Top: 12, Bottom: 12, Left: 16, Right: 16);
      Anchor: (Height: 48);

      Label #HeaderTitle {
        Text: "Правила сервера";
        Style: (FontSize: 18, TextColor: #6eb5ff, RenderBold: true);
        FlexWeight: 1;
        Anchor: (Vertical: 0);
      }

      TextButton #CloseButton {
        Text: "X";
        Anchor: (Width: 28, Height: 28, Vertical: 0);
        Style: TextButtonStyle(
          Default: (LabelStyle: (FontSize: 14, TextColor: #93844c, RenderBold: true)),
          Sounds: $C.@ButtonSounds,
        );
        Background: #000000(0.13);
      }
    }

    Group #Body {
      LayoutMode: Top;
      Padding: (Top: 12, Left: 16, Right: 16, Bottom: 16);
      FlexWeight: 1;

      Label #Subtitle {
        Text: "";
        Style: (FontSize: 12, TextColor: #8cbae8);
        Anchor: (Bottom: 8);
      }

      Group #RulesScroll {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: (Color: #0e1525);
        Padding: (Full: 10);
        OutlineColor: #3a4a6a;
        OutlineSize: 1;

        Label #RulesBody {
          Text: "";
          Style: (FontSize: 13, TextColor: #d0e4f5, Wrap: true);
        }
      }

      TextButton #OkButton {
        Anchor: (Height: 32, Top: 12);
        Padding: (Left: 12, Right: 12, Top: 4, Bottom: 4);
        Text: "Понятно";
        Style: TextButtonStyle(
          Default: (LabelStyle: (FontSize: 14, TextColor: #e8f4ff, RenderBold: true)),
          Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true)),
          Pressed: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true)),
          Sounds: $C.@ButtonSounds,
        );
        Background: #3d5a85;
      }
    }
  }
}
