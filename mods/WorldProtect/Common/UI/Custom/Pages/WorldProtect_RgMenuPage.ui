      // ---- Text flags ----

      Group #GreetingRow {
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Label { Text: "Greeting text"; Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 14, Bottom: 4); }

        Group #GreetingBox {
          LayoutMode: Left;
          Anchor: (Height: 30);
          Background: (Color: #0b1220);
          Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
          OutlineColor: #3a4a6a;
          OutlineSize: 1;

          // Editable input (visible only when the player can edit this field)
          TextField #GreetingText { Style: (FontSize: 12, TextColor: #ffffff); FlexWeight: 1; Visible: true; }
          // Read-only preview (used when the player cannot edit)
          Label #GreetingPreview { Text: ""; Style: (FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); FlexWeight: 1; Visible: false; }

          TextButton #GreetingSaveButton { Text: "Save"; Style: $W.@WpButtonStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
          TextButton #GreetingClearButton { Text: "Clear"; Style: $W.@WpButtonRedStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
        }
      }

      Group #FarewellRow {
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Label { Text: "Farewell text"; Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 14, Bottom: 4); }

        Group #FarewellBox {
          LayoutMode: Left;
          Anchor: (Height: 30);
          Background: (Color: #0b1220);
          Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
          OutlineColor: #3a4a6a;
          OutlineSize: 1;

          TextField #FarewellText { Style: (FontSize: 12, TextColor: #ffffff); FlexWeight: 1; Visible: true; }
          Label #FarewellPreview { Text: ""; Style: (FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); FlexWeight: 1; Visible: false; }

          TextButton #FarewellSaveButton { Text: "Save"; Style: $W.@WpButtonStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
          TextButton #FarewellClearButton { Text: "Clear"; Style: $W.@WpButtonRedStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
        }
      }

      Group #PlayerEnterCommandRow {
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Label { Text: "Player enter command"; Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 14, Bottom: 4); }

        Group #PlayerEnterCommandBox {
          LayoutMode: Left;
          Anchor: (Height: 30);
          Background: (Color: #0b1220);
          Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
          OutlineColor: #3a4a6a;
          OutlineSize: 1;

          TextField #PlayerEnterCommandText { Style: (FontSize: 12, TextColor: #ffffff); FlexWeight: 1; Visible: true; }
          Label #PlayerEnterCommandPreview { Text: ""; Style: (FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); FlexWeight: 1; Visible: false; }

          TextButton #PlayerEnterCommandSaveButton { Text: "Save"; Style: $W.@WpButtonStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
          TextButton #PlayerEnterCommandClearButton { Text: "Clear"; Style: $W.@WpButtonRedStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
        }

        Label { Text: "Use commas for multiple commands. Placeholders: {player}, {region}, {comma}"; Style: (FontSize: 10, TextColor: #666666); Anchor: (Height: 14, Top: 4); }
      }

      Group #ServerEnterCommandRow {
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Label { Text: "Server enter command"; Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 14, Bottom: 4); }

        Group #ServerEnterCommandBox {
          LayoutMode: Left;
          Anchor: (Height: 30);
          Background: (Color: #0b1220);
          Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
          OutlineColor: #3a4a6a;
          OutlineSize: 1;

          TextField #ServerEnterCommandText { Style: (FontSize: 12, TextColor: #ffffff); FlexWeight: 1; Visible: true; }
          Label #ServerEnterCommandPreview { Text: ""; Style: (FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); FlexWeight: 1; Visible: false; }

          TextButton #ServerEnterCommandSaveButton { Text: "Save"; Style: $W.@WpButtonStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
          TextButton #ServerEnterCommandClearButton { Text: "Clear"; Style: $W.@WpButtonRedStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
        }

        Label { Text: "Dangerous: runs as server. Keep permissions tight."; Style: (FontSize: 10, TextColor: #aa6666); Anchor: (Height: 14, Top: 4); }
      }

      Group #BlockedCommandsRow {
        LayoutMode: Top;
        Anchor: (Bottom: 0);

        Label { Text: "Blocked commands"; Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 14, Bottom: 4); }

        Group #BlockedCommandsBox {
          LayoutMode: Left;
          Anchor: (Height: 30);
          Background: (Color: #0b1220);
          Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
          OutlineColor: #3a4a6a;
          OutlineSize: 1;

          TextField #BlockedCommandsText { Style: (FontSize: 12, TextColor: #ffffff); FlexWeight: 1; Visible: true; }
          Label #BlockedCommandsPreview { Text: ""; Style: (FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); FlexWeight: 1; Visible: false; }

          TextButton #BlockedCommandsSaveButton { Text: "Save"; Style: $W.@WpButtonStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
          TextButton #BlockedCommandsClearButton { Text: "Clear"; Style: $W.@WpButtonRedStyle; Anchor: (Width: 60, Height: 24, Vertical: 0, Left: 6); Visible: true; }
        }

        Label { Text: "Comma-separated. Example: /spawn,/warp,/msg"; Style: (FontSize: 10, TextColor: #666666); Anchor: (Height: 14, Top: 4); }
      }
    }
  }
}
// Color panel (visual only for now)
          Group #ColorPanel {
            LayoutMode: Top;
            Anchor: (Width: 220, Height: 280, Vertical: 0);
            Background: (Color: #0e1525);
            Padding: (Top: 10, Bottom: 10, Left: 10, Right: 10);
            OutlineColor: #3a4a6a;
            OutlineSize: 1;

            

            // Compact ColorPicker (same control/style as SimpleClaims).
            // NOTE: Region color is applied only when the player presses Save.
            ColorPicker #RegionColorPicker {
              FlexWeight: 1;
              // IMPORTANT:
              // In some client builds the ColorPicker's bottom slider (percentage bar)
              // does not respond unless the control has a full anchor box like the
              // stock UI (and DisplayTextField is enabled). This matches SimpleClaims.
              Anchor: (Left: 0, Top: 0, Bottom: 8, Right: 0);
              DisplayTextField: true;
              Style: $C.@DefaultColorPickerStyle;
            }

            Group #ColorActionRow {
              LayoutMode: Left;
              Anchor: (Height: 24, Bottom: 8);

              TextButton #ColorAutoButton {
                Text: "Auto";
                Style: $W.@WpButtonUnselectedStyle;
                Anchor: (Width: 60, Height: 24, Vertical: 0, Right: 6);
              }

              TextButton #ColorSaveButton {
                Text: "Save";
                Style: $W.@WpButtonSelectedStyle;
                Anchor: (Width: 60, Height: 24, Vertical: 0);
              }

              Label { FlexWeight: 1; }
            }

            Group #RegionStatsBox {
              LayoutMode: Top;
              Anchor: (Top: 0);
              Background: (Color: #0f1525);
              Padding: (Top: 6, Bottom: 6, Left: 6, Right: 6);
              OutlineColor: #3a4a6a;
              OutlineSize: 1;

              Label #RegionBoundsInfo { Text: ""; Style: (FontSize: 10, TextColor: #aaaaaa); Anchor: (Bottom: 2); }
              Label #RegionSizeInfo   { Text: ""; Style: (FontSize: 10, TextColor: #aaaaaa); Anchor: (Bottom: 2); }
              Label #RegionVolumeInfo { Text: ""; Style: (FontSize: 10, TextColor: #aaaaaa); }
            }

          }

          }

          Label #RegionHint {
            Text: "";
            Style: (FontSize: 11, TextColor: #aaaaaa);
          }
        }
      }
    }
  }


  Group #OwnerAddPanel {
    Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
    Visible: false;
    LayoutMode: Center;

    Group #OwnerAddBounds {
      Anchor: (Width: 720, Height: 520);

      Group #OwnerAddDialog {
        Anchor: (Width: 340, Height: 286, Left: 24, Top: 36);
        LayoutMode: Top;
        Background: (Color: #0f1525f6);
        Padding: (Top: 12, Bottom: 12, Left: 12, Right: 12);
        OutlineColor: #4c5f86;
        OutlineSize: 1;

        Group { LayoutMode: Left; Anchor: (Height: 24, Bottom: 8);
          Label {
            Text: "Add/remove owners";
            Style: (FontSize: 14, TextColor: #FFD700, RenderBold: true);
            Anchor: (Vertical: 0);
            FlexWeight: 1;
          }
          TextButton #OwnerPanelCloseButtonTop { Text: "X"; Style: $W.@WpButtonRedStyle; Anchor: (Width: 24, Height: 24, Vertical: 0); }
        }

        Label {
          Text: "Type a player name to add directly or filter the online list.";
          Style: (FontSize: 10, TextColor: #9aa7c4);
          Anchor: (Height: 14, Bottom: 8);
        }

        Label {
          Text: "Player name";
          Style: (FontSize: 10, TextColor: #888888);
          Anchor: (Height: 14, Bottom: 4);
        }

        Group #OwnerAddInputBox {
          LayoutMode: Left;
          Anchor: (Height: 28, Bottom: 10);
          Background: (Color: #0b1220);
          Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
          OutlineColor: #3a4a6a;
          OutlineSize: 1;

          TextField #OwnerAddText { Style: (FontSize: 12, TextColor: #ffffff); FlexWeight: 1; Anchor: (Height: 20, Vertical: 0, Right: 6); Visible: true; }
          TextButton #OwnerAddButton { Text: "Add"; Style: $W.@WpButtonStyle; Anchor: (Width: 62, Height: 20, Vertical: 0); Visible: true; }
        }

        Group #OwnerAddRow { LayoutMode: Left; Anchor: (Height: 0, Bottom: 0); Visible: false;
          TextButton #OwnerPanelCloseButton { Text: ""; Style: $W.@WpButtonUnselectedStyle; Anchor: (Width: 0, Height: 0, Vertical: 0); Visible: false; }
        }

        Group #OwnerQuickRow { LayoutMode: Top; FlexWeight: 1;
          Label { Text: "Online players"; Style: (FontSize: 10, TextColor: #888888); Anchor: (Height: 14, Bottom: 6); }
          Group #OwnerQuickRow1 { LayoutMode: Left; Anchor: (Height: 24, Bottom: 4);
            TextButton #OwnerQuick1 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0, Right: 4); Visible: false; }
            TextButton #OwnerQuick2 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0, Right: 4); Visible: false; }
            TextButton #OwnerQuick3 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0, Right: 4); Visible: false; }
            TextButton #OwnerQuick4 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0); Visible: false; }
          }
          Group #OwnerQuickRow2 { LayoutMode: Left; Anchor: (Height: 24, Bottom: 4);
            TextButton #OwnerQuick5 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0, Right: 4); Visible: false; }
            TextButton #OwnerQuick6 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0, Right: 4); Visible: false; }
            TextButton #OwnerQuick7 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0, Right: 4); Visible: false; }
            TextButton #OwnerQuick8 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0); Visible: false; }
          }
          Group #OwnerQuickRow3 { LayoutMode: Left; Anchor: (Height: 24, Bottom: 4);
            TextButton #OwnerQuick9 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0, Right: 4); Visible: false; }
            TextButton #OwnerQuick10 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0, Right: 4); Visible: false; }
            TextButton #OwnerQuick11 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0, Right: 4); Visible: false; }
            TextButton #OwnerQuick12 { Text: "+"; Style: $W.@WpButtonStyle; Anchor: (Width: 68, Height: 22, Vertical: 0); Visible: false; }
          }
