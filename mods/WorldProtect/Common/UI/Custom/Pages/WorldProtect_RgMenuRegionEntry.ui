Button #RegionEntry {
  LayoutMode: Left;
  Background: (Color: #1a2a4a);
  Padding: (Top: 6, Bottom: 6, Left: 12, Right: 12);
  Anchor: (Left: 0, Right: 0, Height: 56, Bottom: 3);

  // Region name (left)
  Label #RegionName {
    Text: "Region";
    Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
    Anchor: (Width: 190, Vertical: 0, Right: 12);
  }

  // Role badge (middle-left)
  Group #RoleGroup {
    LayoutMode: Center;
    Anchor: (Width: 110, Vertical: 0, Right: 12);

    Label #RegionRoleOwner {
      Text: "OWNER";
      Visible: false;
      Style: (FontSize: 13, TextColor: #ff4b4b, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
    }

    Label #RegionRoleMember {
      Text: "MEMBER";
      Visible: false;
      Style: (FontSize: 13, TextColor: #ffb347, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
    }
  }

  // Details (center)
  Group {
    LayoutMode: Top;
    FlexWeight: 1;
    Anchor: (Vertical: 0);

    Label #RegionMeta {
      Text: "World: default";
      Style: (FontSize: 11, TextColor: #aaaaaa, HorizontalAlignment: Center);
      Anchor: (Left: 0, Right: 0, Bottom: 2);
    }

    Label #RegionBounds {
      Text: "56x80x59 | 631m";
      Style: (FontSize: 10, TextColor: #888888, HorizontalAlignment: Center);
      Anchor: (Left: 0, Right: 0);
    }
  }

  // Right side action
  Group {
    LayoutMode: Center;
    Anchor: (Width: 110, Vertical: 0);

    Label #RegionAction {
      Text: "MANAGE";
      Style: (FontSize: 11, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
    }
  }
}
