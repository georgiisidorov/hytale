$C = "../../Common.ui";

Group #PopupRoot {
  Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
  LayoutMode: Center;

  Group #PopupCard {
    Anchor: (Width: 560, Height: 480);
    Background: (Color: #1a1a2eee);
    LayoutMode: Top;
    OutlineColor: #3a4a6a;
    OutlineSize: 1;

    Group #Header {
      LayoutMode: Left;
      Background: (Color: #0f1525);
      Padding: (Top: 12, Bottom: 12, Left: 16, Right: 16);
      Anchor: (Height: 48);

      Label #HeaderTitle {
        Text: "Popup";
        Style: (FontSize: 18, TextColor: #6eb5ff, RenderBold: true);
        FlexWeight: 1;
        Anchor: (Vertical: 0);
      }

      TextButton #CloseButton {
        Text: "X";
        Anchor: (Width: 28, Height: 28, Vertical: 0);
        Style: TextButtonStyle(
          Default: (LabelStyle: (FontSize: 14, TextColor: #93844c, RenderBold: true)),
          Sounds: $C.@ButtonSounds,
        );
        Background: #000000(0.13);
      }
    }

    Group #Body {
      LayoutMode: Top;
      Padding: (Top: 12, Left: 16, Right: 16, Bottom: 16);
      FlexWeight: 1;

      Label #Subtitle {
        Text: "";
        Style: (FontSize: 12, TextColor: #8cbae8);
        Anchor: (Bottom: 8);
      }

      Group #BodyScroll {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: (Color: #0e1525);
        Padding: (Full: 10);
        OutlineColor: #3a4a6a;
        OutlineSize: 1;

        Label #BodyText {
          Text: " ";
          Style: (FontSize: 13, TextColor: #d0e4f5, Wrap: true);
        }
      }

      Group #Actions {
        LayoutMode: Top;
        Anchor: (Top: 10);

        TextButton #Action0 {
          Visible: false;
          Anchor: (Height: 30, Bottom: 4);
          Padding: (Left: 10, Right: 10, Top: 2, Bottom: 2);
          Text: "";
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 13, TextColor: #7fd695, RenderBold: true)),
            Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffd700, RenderBold: true)),
            Sounds: $C.@ButtonSounds,
          );
          Background: #1a3d2a;
        }

        TextButton #Action1 {
          Visible: false;
          Anchor: (Height: 30, Bottom: 4);
          Padding: (Left: 10, Right: 10, Top: 2, Bottom: 2);
          Text: "";
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 13, TextColor: #7fd695, RenderBold: true)),
            Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffd700, RenderBold: true)),
            Sounds: $C.@ButtonSounds,
          );
          Background: #1a3d2a;
        }

        TextButton #Action2 {
          Visible: false;
          Anchor: (Height: 30, Bottom: 4);
          Padding: (Left: 10, Right: 10, Top: 2, Bottom: 2);
          Text: "";
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 13, TextColor: #7fd695, RenderBold: true)),
            Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffd700, RenderBold: true)),
            Sounds: $C.@ButtonSounds,
          );
          Background: #1a3d2a;
        }

        TextButton #Action3 {
          Visible: false;
          Anchor: (Height: 30, Bottom: 4);
          Padding: (Left: 10, Right: 10, Top: 2, Bottom: 2);
          Text: "";
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 13, TextColor: #7fd695, RenderBold: true)),
            Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffd700, RenderBold: true)),
            Sounds: $C.@ButtonSounds,
          );
          Background: #1a3d2a;
        }

        TextButton #Action4 {
          Visible: false;
          Anchor: (Height: 30, Bottom: 4);
          Padding: (Left: 10, Right: 10, Top: 2, Bottom: 2);
          Text: "";
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 13, TextColor: #7fd695, RenderBold: true)),
            Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffd700, RenderBold: true)),
            Sounds: $C.@ButtonSounds,
          );
          Background: #1a3d2a;
        }

      }

      TextButton #OkButton {
        Anchor: (Height: 32, Top: 10);
        Padding: (Left: 12, Right: 12, Top: 4, Bottom: 4);
        Text: "OK";
        Style: TextButtonStyle(
          Default: (LabelStyle: (FontSize: 14, TextColor: #e8f4ff, RenderBold: true)),
          Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true)),
          Sounds: $C.@ButtonSounds,
        );
        Background: #3d5a85;
      }

      Label #Status {
        Text: "";
        Style: (FontSize: 11, TextColor: #96a9be);
        Anchor: (Top: 6);
      }
    }
  }
}
