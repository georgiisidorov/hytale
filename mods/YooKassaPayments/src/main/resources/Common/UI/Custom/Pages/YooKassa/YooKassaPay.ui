            Group #ShopDetailDescScroll {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              MouseWheelScrollBehaviour: VerticalOnly;
              Anchor: (Height: 150, Bottom: 8);
              Padding: (Top: 10, Left: 12, Right: 10, Bottom: 10);
              Background: (Color: #0a1628);
              OutlineColor: #1e3352;
              OutlineSize: 1;

              Label #ShopDetailDesc { Text: ""; Style: (FontSize: 14, TextColor: #9eb1c9, Wrap: true); }
            }

            Group { FlexWeight: 1; }

            Group #ShopDetailDivider1 { Anchor: (Height: 1, Bottom: 8); Background: (Color: #3a4a6a); }

            Label #ShopDetailStat1 { Text: ""; Style: (FontSize: 14, TextColor: #7fd695); Anchor: (Bottom: 4); }
            Label #ShopDetailStat2 { Text: ""; Style: (FontSize: 14, TextColor: #7fd695); Anchor: (Bottom: 4); }
            Label #ShopDetailStat3 { Text: ""; Style: (FontSize: 14, TextColor: #7fd695); Anchor: (Bottom: 8); }

            Group #ShopDetailDivider2 { Anchor: (Height: 1, Bottom: 8); Background: (Color: #3a4a6a); }

            Label #ShopDetailPrice { Text: ""; Style: (FontSize: 17, TextColor: #f1d27a, RenderBold: true, HorizontalAlignment: Center); Anchor: (Bottom: 10); }

            TextButton #ShopConfirmButton { Anchor: (Height: 46); Text: "КУПИТЬ"; Style: @PrimaryButton; Background: #d7a83f; }
          }
        }
      }

      Group #WalletPage { Visible: false; LayoutMode: Top; FlexWeight: 1; Padding: (Top: 14, Left: 16, Right: 16, Bottom: 14);
        Label #Hint { Text: ""; Style: (FontSize: 14, TextColor: #a0b0c0, Wrap: true); Anchor: (Bottom: 8); }
        Label #SavedHint { Text: ""; Style: (FontSize: 14, TextColor: #96a9be, Wrap: true); Anchor: (Bottom: 10); }

        Group #FormSection { Visible: true; LayoutMode: Top; Background: (Color: #10243f); Padding: (Full: 18); Anchor: (Bottom: 12);

          Group #WalletAmountRow {
            LayoutMode: Center;
            Anchor: (Bottom: 28);

            Group #WalletAmountInnerRow {
              LayoutMode: Left;

              TextField #AmountField {
                Anchor: (Width: 200, Height: 48);
                PlaceholderText: "0 руб";
                Padding: (Left: 14, Right: 14, Top: 10, Bottom: 10);
                Background: (Color: #0f1525);
                Style: (FontSize: 16, TextColor: #ffffff);
              }

                Group #WalletAmountGap { Anchor: (Width: 24); }

