            Group #ShopPagination {
              LayoutMode: Left;
              Anchor: (Height: 34, Top: 8, Left: 0, Right: 0);

              TextButton #ShopPrevPage { Visible: false; Anchor: (Width: 90, Height: 34); Text: "<—"; Style: @CatTabStyle; Background: #10243f; }
              Group { FlexWeight: 1; }
              Label #ShopPageLabel { Text: "1 / 1"; Style: (FontSize: 13, TextColor: #9eb1c9, HorizontalAlignment: Center); Anchor: (Vertical: 0); }
              Group { FlexWeight: 1; }
              TextButton #ShopNextPage { Visible: false; Anchor: (Width: 90, Height: 34); Text: "—>"; Style: @CatTabStyle; Background: #10243f; }
            }
          }

          Group #ShopDivider { Anchor: (Width: 2, Top: 0, Bottom: 0, Right: 10); Background: (Color: #2a4468); }

          Group #ShopDetail {
            LayoutMode: Top;
            Anchor: (Width: 300, Top: 0, Bottom: 0);
            Background: (Color: #10243f);
            Padding: (Full: 14);
