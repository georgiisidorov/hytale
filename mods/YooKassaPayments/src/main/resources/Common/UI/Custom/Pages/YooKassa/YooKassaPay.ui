$C = "../../Common.ui";

@TabStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 14, TextColor: #d8e2f0, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffd76b, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@PrimaryButton = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffd76b, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@WalletButton = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 18, TextColor: #ffd76b, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@WalletButtonInline = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 18, TextColor: #ffd76b, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@WalletPayRowBtn = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 16, TextColor: #ffd76b, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@CatTabStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 16, TextColor: #9eb1c9, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 16, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@CatTabActiveStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@HeaderPlusCoinsStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 37, TextColor: #f1d27a, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 37, TextColor: #f7e4af, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@HeaderPlusCrystalsStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 37, TextColor: #8ec8ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 37, TextColor: #bbdeff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@HeaderCloseStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 37, TextColor: #d5d5d5, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 37, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds,
);

@SaveRememberBtnStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: #2f8f4f(0.45)),
  Hovered: (LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: #2f8f4f(0.6)),
  Sounds: $C.@ButtonSounds,
);

@SaveForgetBtnStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: #c0392b(0.45)),
  Hovered: (LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: #c0392b(0.6)),
  Sounds: $C.@ButtonSounds,
);

Group #YooKassaRoot {
  Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
  LayoutMode: Center;

  Group #YooKassaCard {
    Anchor: (Width: 1280, Height: 780);
    Background: "Images/bg_shop.png";
    LayoutMode: Top;
    OutlineColor: #244469;
    OutlineSize: 1;

    Group #MarketHeader {
      LayoutMode: Left;
      Background: (Color: #10223a);
      Padding: (Top: 10, Bottom: 10, Left: 14, Right: 14);
      Anchor: (Height: 68);

      Group #Tabs {
        LayoutMode: Left;

        TextButton #TabShop { Anchor: (Width: 96, Height: 36, Right: 4, Vertical: 0); Text: "Магазин"; Style: @TabStyle; Background: #243855; }
        TextButton #TabWheel { Anchor: (Width: 86, Height: 36, Right: 4, Vertical: 0); Text: "Колесо"; Style: @TabStyle; Background: #172a46; }
        TextButton #TabPacks { Anchor: (Width: 74, Height: 36, Right: 4, Vertical: 0); Text: "Паки"; Style: @TabStyle; Background: #172a46; }
        TextButton #TabMinigames { Anchor: (Width: 110, Height: 36, Right: 4, Vertical: 0); Text: "Мини-игры"; Style: @TabStyle; Background: #172a46; }
        TextButton #TabVoucher { Anchor: (Width: 90, Height: 36, Right: 8, Vertical: 0); Text: "Ваучер"; Style: @TabStyle; Background: #172a46; }
      }

      Group #TabsSpacer {
        FlexWeight: 1;
        Anchor: (Vertical: 0);
      }

      Group #HeaderGap {
        Anchor: (Width: 20, Vertical: 0);
      }

      Group #HeaderBalances {
        LayoutMode: Left;
        Anchor: (Vertical: 0);

        Group #TopUpCoinsPlusWrap {
          LayoutMode: Top;
          Anchor: (Width: 50, Height: 48, Right: 6, Vertical: 0);

          TextButton #TopUpCoinsPlus {
            Anchor: (Width: 50, Height: 50, Top: -2);
            Padding: (Full: 0);
            Text: "+";
            Style: @HeaderPlusCoinsStyle;
            Background: #000000(0);
          }
        }
        Label #CoinsBalance {
          Text: "12 450 монет";
          Style: (FontSize: 20, TextColor: #f1d27a, RenderBold: true, VerticalAlignment: Center);
          Anchor: (Width: 168, Height: 28, Right: 12, Vertical: 0);
        }

        Group #TopUpCrystalsPlusWrap {
          LayoutMode: Top;
          Anchor: (Width: 50, Height: 48, Right: 6, Vertical: 0);

          TextButton #TopUpCrystalsPlus {
            Anchor: (Width: 50, Height: 50, Top: -2);
            Padding: (Full: 0);
            Text: "+";
            Style: @HeaderPlusCrystalsStyle;
            Background: #000000(0);
          }
        }
        Label #CrystalsBalance {
          Text: "840 алмазов";
          Style: (FontSize: 20, TextColor: #8ec8ff, RenderBold: true, VerticalAlignment: Center);
          Anchor: (Width: 180, Height: 28, Right: 8, Vertical: 0);
        }
      }

      Group #CloseButtonWrap {
        LayoutMode: Top;
        Anchor: (Width: 50, Height: 48, Vertical: 0);

        TextButton #CloseButton {
          Text: "×";
          Anchor: (Width: 50, Height: 50, Top: -2);
          Padding: (Full: 0);
          Style: @HeaderCloseStyle;
          Background: #000000(0);
        }
      }
    }

    Group #Content {
      LayoutMode: Top;
      FlexWeight: 1;

      Group #ShopPage {
        LayoutMode: Top;
        Visible: true;
        FlexWeight: 1;
        Padding: (Top: 14, Left: 16, Right: 16, Bottom: 14);

        Group #ShopCategories {
          LayoutMode: Top;
          Anchor: (Height: 44, Bottom: 12, Left: 0, Right: 0);

          Group #ShopCatRow1 {
            LayoutMode: Left;
            Anchor: (Height: 42, Left: 0, Right: 0);

            Group { FlexWeight: 1; Anchor: (Height: 42, Right: 4);
              TextButton #CatBuild       { Visible: false; Anchor: (Left: 0, Right: 0, Height: 42); Text: "Стройка"; Style: @CatTabStyle;       Background: #10243f; }
              TextButton #CatBuildActive { Visible: true;  Anchor: (Left: 0, Right: 0, Height: 42); Text: "Стройка"; Style: @CatTabActiveStyle; Background: #1e3a5f; }
            }
            Group { FlexWeight: 1; Anchor: (Height: 42, Right: 4);
              TextButton #CatWood        { Visible: true;  Anchor: (Left: 0, Right: 0, Height: 42); Text: "Дерево";  Style: @CatTabStyle;       Background: #10243f; }
              TextButton #CatWoodActive  { Visible: false; Anchor: (Left: 0, Right: 0, Height: 42); Text: "Дерево";  Style: @CatTabActiveStyle; Background: #1e3a5f; }
            }
            Group { FlexWeight: 1; Anchor: (Height: 42, Right: 4);
              TextButton #CatCraft       { Visible: true;  Anchor: (Left: 0, Right: 0, Height: 42); Text: "Крафт";   Style: @CatTabStyle;       Background: #10243f; }
              TextButton #CatCraftActive { Visible: false; Anchor: (Left: 0, Right: 0, Height: 42); Text: "Крафт";   Style: @CatTabActiveStyle; Background: #1e3a5f; }
            }
            Group { FlexWeight: 1; Anchor: (Height: 42, Right: 4);
              TextButton #CatAlchemy       { Visible: true;  Anchor: (Left: 0, Right: 0, Height: 42); Text: "Алхимия";  Style: @CatTabStyle;       Background: #10243f; }
              TextButton #CatAlchemyActive { Visible: false; Anchor: (Left: 0, Right: 0, Height: 42); Text: "Алхимия";  Style: @CatTabActiveStyle; Background: #1e3a5f; }
            }
            Group { FlexWeight: 1; Anchor: (Height: 42, Right: 4);
              TextButton #CatPlant       { Visible: true;  Anchor: (Left: 0, Right: 0, Height: 42); Text: "Растения"; Style: @CatTabStyle;       Background: #10243f; }
              TextButton #CatPlantActive { Visible: false; Anchor: (Left: 0, Right: 0, Height: 42); Text: "Растения"; Style: @CatTabActiveStyle; Background: #1e3a5f; }
            }
            Group { FlexWeight: 1; Anchor: (Height: 42, Right: 4);
              TextButton #CatWeapon       { Visible: true;  Anchor: (Left: 0, Right: 0, Height: 42); Text: "Оружие";  Style: @CatTabStyle;       Background: #10243f; }
              TextButton #CatWeaponActive { Visible: false; Anchor: (Left: 0, Right: 0, Height: 42); Text: "Оружие";  Style: @CatTabActiveStyle; Background: #1e3a5f; }
            }
            Group { FlexWeight: 1; Anchor: (Height: 42);
              TextButton #CatArmor       { Visible: true;  Anchor: (Left: 0, Right: 0, Height: 42); Text: "Доспехи"; Style: @CatTabStyle;       Background: #10243f; }
              TextButton #CatArmorActive { Visible: false; Anchor: (Left: 0, Right: 0, Height: 42); Text: "Доспехи"; Style: @CatTabActiveStyle; Background: #1e3a5f; }
            }
          }
        }

        Group #ShopMain {
          LayoutMode: Left;
          FlexWeight: 1;

          Group #ShopGrid {
            LayoutMode: Top;
            FlexWeight: 1;
            Anchor: (Right: 10);

            Group #ShopGridRow1 {
              LayoutMode: Left;
              FlexWeight: 1;

              Group #ProductCard1 { LayoutMode: Top; FlexWeight: 1; Anchor: (Right: 8, Top: 0, Bottom: 0); Background: (Color: #10243f); Padding: (Full: 10); OutlineColor: #244469; OutlineSize: 1;
                Group #ProductCard1Art { LayoutMode: Center; FlexWeight: 1;
                  Panel #PC1I0 { Anchor: (Width: 168, Height: 168); Visible: false; Background: "Images/Shop/items/Armor_Adamantite_Chest.png"; }
                  Panel #PC1I1 { Anchor: (Width: 168, Height: 168); Visible: false; Background: "Images/Shop/items/Armor_Adamantite_Head.png"; }
                  Panel #PC1I2 { Anchor: (Width: 168, Height: 168); Visible: false; Background: "Images/Shop/items/Armor_Adamantite_Legs.png"; }
