              LayoutMode: Center;
              FlexWeight: 1;

              Group #WheelSegments {
                Anchor: (Width: 562, Height: 541);

                Panel #WheelBase { Anchor: (Left: 0, Top: 0, Width: 562, Height: 541); Background: "Images/Wheel/wheel.png"; }

                // Item icons: sector 0 = top, clockwise. Shuffled layout.
                Panel #WheelIcon0  { Anchor: (Left: 276, Top: 39,  Width: 104, Height: 104); Background: "Images/Wheel/chest4.png"; }
                Panel #WheelIcon1  { Anchor: (Left: 365, Top: 94,  Width: 87,  Height: 87);  }
