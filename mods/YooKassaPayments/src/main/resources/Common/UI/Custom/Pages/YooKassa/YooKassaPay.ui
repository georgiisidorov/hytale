          }

          // Right: reward unlocked (in-page)
          Group #WheelRewardCard {
            LayoutMode: Top;
            Anchor: (Width: 340, Top: 0, Bottom: 0);
            Background: (Color: #10243f);
            OutlineColor: #244469;
            OutlineSize: 1;
            Padding: (Full: 8);

            Label #WheelRewardTitle { Text: "Награда получена"; Style: (FontSize: 21, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center); Anchor: (Bottom: 4); }

            Group #WheelRewardIconRow {
              LayoutMode: Center;
              Anchor: (Height: 358, Bottom: 6);

              Panel #WheelRewardIcon0  { Visible: false; Anchor: (Width: 358, Height: 358); Background: "Images/Wheel/chest4.png"; }
              Panel #WheelRewardIcon1  { Visible: false; Anchor: (Width: 358, Height: 358); }
              Panel #WheelRewardIcon2  { Visible: false; Anchor: (Width: 358, Height: 358); Background: "Images/Wheel/chest2.png"; }
              Panel #WheelRewardIcon3  { Visible: false; Anchor: (Width: 322, Height: 322); Background: "Images/Wheel/free_spin.png"; }
              Panel #WheelRewardIcon4  { Visible: false; Anchor: (Width: 358, Height: 358); Background: "Images/Wheel/chest6.png"; }
              Panel #WheelRewardIcon5  { Visible: false; Anchor: (Width: 358, Height: 358); Background: "Images/Wheel/coins.png"; }
              Panel #WheelRewardIcon6  { Visible: false; Anchor: (Width: 358, Height: 358); Background: "Images/Wheel/chest1.png"; }
              Panel #WheelRewardIcon7  { Visible: false; Anchor: (Width: 358, Height: 358); Background: "Images/Wheel/items/Plant_Fruit_Apple.png"; }
              Panel #WheelRewardIcon8  { Visible: false; Anchor: (Width: 358, Height: 358); Background: "Images/Wheel/chest3.png"; }
              Panel #WheelRewardIcon9  { Visible: false; Anchor: (Width: 358, Height: 358); }
              Panel #WheelRewardIcon10 { Visible: false; Anchor: (Width: 358, Height: 358); Background: "Images/Wheel/chest5.png"; }
              Panel #WheelRewardIcon11 { Visible: false; Anchor: (Width: 358, Height: 358); Background: "Images/Wheel/coins.png"; }
            }

            Label #WheelRewardYouReceived { Text: "Вы получили:"; Style: (FontSize: 21, TextColor: #d0e4f5, HorizontalAlignment: Center); Anchor: (Bottom: 2); }
            Label #WheelRewardItemName { Text: "—"; Style: (FontSize: 23, TextColor: #b87aff, RenderBold: true, HorizontalAlignment: Center, Wrap: true); Anchor: (Bottom: 2); }
            Label #WheelRewardRarity { Text: "Редкость: —"; Style: (FontSize: 21, TextColor: #b87aff, HorizontalAlignment: Center); FlexWeight: 1; Anchor: (Bottom: 4); }
          }
        }

        // Bottom: reward pool info
        Group #WheelPoolInfo {
          LayoutMode: Left;
          Anchor: (Height: 144, Left: 0, Right: 0);
          Background: (Color: #10243f);
          Padding: (Full: 12);
          OutlineColor: #244469;
          OutlineSize: 1;

          Group #WheelDropRates {
            LayoutMode: Top;
            Anchor: (Width: 244, Right: 12, Top: 0, Bottom: 0);

            Label #WheelPoolInfoTitle { Text: "Состав наград"; Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true); Anchor: (Bottom: 8); }
            Label #WheelDropRatesBody { Text: ""; Style: (FontSize: 15, TextColor: #d0e4f5, Wrap: true); FlexWeight: 1; }
          }

          Group #WheelPoolInfoBody {
            LayoutMode: Left;
            FlexWeight: 1;
            Anchor: (Right: 12, Top: 0, Bottom: 0);

            Label #WheelPoolInfoCol1 { Text: ""; Style: (FontSize: 13, TextColor: #d0e4f5, Wrap: true); FlexWeight: 1; Anchor: (Right: 8); }
            Label #WheelPoolInfoCol2 { Text: ""; Style: (FontSize: 13, TextColor: #d0e4f5, Wrap: true); FlexWeight: 1; }
          }

          Group #WheelPoolInfoActions {
            LayoutMode: Top;
            Anchor: (Width: 300, Top: 0, Bottom: 0);
            Label #WheelPoolInfoHint { Text: ""; Style: (FontSize: 13, TextColor: #9eb1c9, Wrap: true); FlexWeight: 1; Anchor: (Bottom: 8); }
          }
        }
      }

      Group #VoucherPage { Visible: false; LayoutMode: Top; FlexWeight: 1; Padding: (Top: 40, Left: 100, Right: 100, Bottom: 40);
        Group { FlexWeight: 1; }
        Group #VoucherForm { LayoutMode: Top; Background: (Color: #10243f); Padding: (Top: 32, Left: 40, Right: 40, Bottom: 32); OutlineColor: #244469; OutlineSize: 1;
          Label { Text: "Активировать ваучер"; Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center); Anchor: (Bottom: 10); }
          Label { Text: "Введите код ваучера, полученный после оплаты лут-пака на сайте"; Style: (FontSize: 14, TextColor: #9eb1c9, Wrap: true, HorizontalAlignment: Center); Anchor: (Bottom: 28); }

          Group #VoucherInputRow { LayoutMode: Center; Anchor: (Bottom: 16);
            TextField #VoucherCodeField {
              Anchor: (Width: 380, Height: 56);
              PlaceholderText: "XXXX-XXXX-XXXX";
              Padding: (Left: 18, Right: 18, Top: 14, Bottom: 14);
              Background: (Color: #0a1628);
              Style: (FontSize: 20, TextColor: #ffffff);
            }
          }

          Group #VoucherButtonRow { LayoutMode: Center; Anchor: (Bottom: 20);
            TextButton #VoucherApplyButton { Anchor: (Width: 240, Height: 52); Text: "Активировать"; Style: @PrimaryButton; Background: #2d7a3d; }
          }

          Group #VoucherStatusRow { LayoutMode: Center;
            Group #VoucherStatusWrap { LayoutMode: Top; Anchor: (Width: 560);
              Label #VoucherStatusOk  { Visible: false; Text: ""; Style: (FontSize: 14, TextColor: #7fd695, Wrap: true, HorizontalAlignment: Center); }
              Label #VoucherStatusErr { Visible: false; Text: ""; Style: (FontSize: 14, TextColor: #e05050, Wrap: true, HorizontalAlignment: Center); }
            }
          }
        }
        Group { FlexWeight: 1; }
      }
    }
  }
}

