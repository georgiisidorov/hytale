                Panel #WheelIcon10 { Anchor: (Left: 98,  Top: 86,  Width: 104, Height: 104); Background: "Images/Wheel/chest5.png"; }
                Panel #WheelIcon11 { Anchor: (Left: 186, Top: 47,  Width: 87,  Height: 87);  Background: "Images/Wheel/coins.png"; }

                // White alpha highlight overlays (only during spin / final result)
                Panel #WheelHl0 { Visible: false; Anchor: (Left: 0, Top: 0, Width: 562, Height: 541); Background: "Images/Wheel/highlight01.png"; }
                Panel #WheelHl1 { Visible: false; Anchor: (Left: 0, Top: 0, Width: 562, Height: 541); Background: "Images/Wheel/highlight02.png"; }
